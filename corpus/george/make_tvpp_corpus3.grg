// ============================================================
// make_tvpp_corpus3.grg — tuiles (images > 64 px) et modes de fusion
// Toutes les variations portent sur l'image 2 (et 3) : c'est là que
// TVPaint découpe en tuiles de 64x64 et ne stocke que ce qui change.
// Carrés d'au moins 8 px (les tracés d'un pixel ne s'impriment pas).
// ============================================================

base = "C:/projets/nebuleuse/TECH/test_tvpp/sorties"
FPS = 24

// ============================================================
// GROUPE T — Tuiles
// ============================================================

// T01 : 128x64 (2 tuiles côte à côte) ; image 2 ne change que la tuile de droite
NewProj(base, "T01_128x64_right_tile", 128, 64, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(8, 8, 16, 255, 0, 0)
Square(80, 8, 16, 0, 255, 0)
SaveAndClose(base, "T01_128x64_right_tile")

// T02 : 64x128 (2 tuiles empilées) ; image 2 ne change que la tuile du bas
NewProj(base, "T02_64x128_bottom_tile", 64, 128, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(8, 8, 16, 255, 0, 0)
Square(8, 80, 16, 0, 255, 0)
SaveAndClose(base, "T02_64x128_bottom_tile")

// T03 : 128x128 (4 tuiles) ; image 2 = image 1 + carré dans la tuile en bas à droite
NewProj(base, "T03_128_one_tile", 128, 128, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(8, 8, 16, 255, 0, 0)
Square(80, 80, 16, 0, 255, 0)
SaveAndClose(base, "T03_128_one_tile")

// T04 : 128x128 ; image 2 = carré au centre qui touche les 4 tuiles
NewProj(base, "T04_128_all_tiles", 128, 128, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(48, 48, 32, 0, 255, 0)
SaveAndClose(base, "T04_128_all_tiles")

// T05 : 128x128 ; image 2 identique à l'image 1
NewProj(base, "T05_128_identical", 128, 128, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(8, 8, 16, 255, 0, 0)
SaveAndClose(base, "T05_128_identical")

// T06 : 128x128 ; image 2 vide
NewProj(base, "T06_128_second_empty", 128, 128, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
SaveAndClose(base, "T06_128_second_empty")

// T07 : 128x128, 3 images ; image 3 = image 2 + changement dans la tuile en haut à gauche
// (la référence pointe-t-elle vers l'image précédente ou vers l'image 1 ?)
NewProj(base, "T07_128_three_images", 128, 128, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(8, 8, 16, 255, 0, 0)
Square(80, 80, 16, 0, 255, 0)
NextImage(2)
Square(8, 8, 16, 255, 0, 0)
Square(80, 80, 16, 0, 255, 0)
Square(32, 32, 16, 0, 0, 255)
SaveAndClose(base, "T07_128_three_images")

// T08 : 130x70 (tuiles de bord incomplètes) ; image 2 change dans la tuile du coin
NewProj(base, "T08_130x70_edge_tile", 130, 70, FPS)
Square(8, 8, 16, 255, 0, 0)
NextImage(1)
Square(8, 8, 16, 255, 0, 0)
Square(128, 66, 8, 0, 255, 0)
SaveAndClose(base, "T08_130x70_edge_tile")

// T09 : 128x128, une seule image, carré à cheval sur les 4 tuiles (contrôle DBOD)
NewProj(base, "T09_128_single_cross", 128, 128, FPS)
Square(48, 48, 32, 255, 0, 0)
SaveAndClose(base, "T09_128_single_cross")

// ============================================================
// GROUPE K — Table des modes de fusion : un calque par mode
// Un mode inconnu restera « Color » dans le CSV.
// ============================================================

NewProj(base, "K01_blend_modes", 64, 64, FPS)
Square(0, 0, 63, 128, 128, 128)
BlendLayer("Color")
BlendLayer("Behind")
BlendLayer("Erase")
BlendLayer("Shade")
BlendLayer("Light")
BlendLayer("Colorize")
BlendLayer("Hue")
BlendLayer("Saturation")
BlendLayer("Value")
BlendLayer("Add")
BlendLayer("Sub")
BlendLayer("Multiply")
BlendLayer("Screen")
BlendLayer("Replace")
BlendLayer("Copy")
BlendLayer("Difference")
BlendLayer("Divide")
BlendLayer("Overlay")
BlendLayer("Light2")
BlendLayer("Shade2")
BlendLayer("HardLight")
BlendLayer("SoftLight")
BlendLayer("GrainExtract")
BlendLayer("GrainMerge")
BlendLayer("Sub2")
BlendLayer("Darken")
BlendLayer("Lighten")
SaveAndClose(base, "K01_blend_modes")

tv_Warn "Corpus 3 terminé"

// ============================================================
// FONCTIONS
// ============================================================

FUNCTION NewProj(pbase, pname, pw, ph, pfps)
	LOCAL ppath
	ppath = CONCAT(pbase, "/")
	ppath = CONCAT(ppath, pname)
	ppath = CONCAT(ppath, ".tvpp")
	tv_ProjectNew ppath pw ph 1.0 pfps "none" 0
END

FUNCTION SaveAndClose(pbase, pname)
	LOCAL ppath gt
	ppath = CONCAT(pbase, "/")
	ppath = CONCAT(ppath, pname)
	gt = CONCAT(ppath, "_gt")
	ppath = CONCAT(ppath, ".tvpp")
	tv_UpdateUndo
	tv_LayerCreate "tmp_commit"
	tv_LayerKill result
	tv_SaveProject ppath
	tv_ClipSaveStructure gt "CSV"
	tv_ProjectClose
END

FUNCTION NextImage(idx)
	tv_LayerInsertImage 1 "after"
	tv_LayerImage idx
END

FUNCTION Square(x, y, s, r, g, b)
	LOCAL x2 y2
	x2 = x + s
	y2 = y + s
	tv_SetAPen r g b
	tv_RectFill x y x2 y2
END

// Crée un calque nommé comme le mode, y dessine un carré, applique le mode
FUNCTION BlendLayer(mode)
	LOCAL lid
	tv_LayerCreate mode
	lid = result
	tv_LayerSet lid
	Square(16, 16, 32, 255, 64, 0)
	tv_LayerBlendingMode lid mode
END
