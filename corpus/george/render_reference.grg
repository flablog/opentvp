// ============================================================
// render_reference.grg — rendu de référence TVPaint pour comparer avec tvpp_render
// Renseigne le chemin du .tvpp et le dossier de sortie, puis lance le script.
// Rendu à travers la caméra, sur toute la durée (les marques limitent le rendu).
// Noms produits : ref_0000.png, ref_0001.png, ... (pas d'autre chiffre dans le nom)
// ============================================================

fichier = "C:/chemin/vers/sq001_sh150_colo.tvpp"
sortie = "C:/projets/nebuleuse/TECH/test_tvpp/sorties/ref_sh"

tv_LoadProject fichier
out = CONCAT(sortie, "/ref_0000.png")
tv_ProjectSaveSequence out "camera"
tv_ProjectClose
tv_Warn "Rendu de référence terminé"
