// ============================================================
// make_tvpp_cam4.grg — corpus caméra, 4e passe : loi de timing
// Pour chaque cas : on place les points de caméra, puis on demande à TVPaint
// la caméra interpolée (tv_CameraInterpolation) à 49 positions entre 0 et 1.
// Les réponses sont rangées DANS le projet (tv_WriteProjectString, section
// « camtest ») : un seul fichier .tvpp à renvoyer, aucun rendu.
// Points : y = 144, x = 64 + cumul des longueurs (unité 32 px).
// Nom de cas S3_102 = trois segments de longueurs 1, 0, 2.
// ============================================================

base = "C:/projets/nebuleuse/TECH/test_tvpp/sorties"
ppath = CONCAT(base, "/L01_camera_timing.tvpp")
tv_ProjectNew ppath 512 288 1.0 24 "none" 0
tv_CameraInfo 256 144
tv_WriteProjectString "camtest" "ncases" "60"
// diagnostics : écriture avec variables, puis une interpolation brute
dk = "diag_variables"
dv = "ok"
tv_WriteProjectString "camtest" dk dv
tv_CameraInsertPoint 0 100 100 0 1
tv_CameraInsertPoint 1 200 100 0 1
tv_CameraInterpolation 0.5
PARSE result d1 d2 d3 d4
tv_WriteProjectString "camtest" "diag_x" d1
tv_WriteProjectString "camtest" "diag_zoom" d4
ClearPoints(2)

// V_M01
tv_CameraInsertPoint 0 160 144 0 1
tv_CameraInsertPoint 1 160 144 0 1
tv_CameraInsertPoint 2 352 144 0 1
tv_CameraInsertPoint 3 352 144 0 1
Sample("V_M01")
ClearPoints(4)

