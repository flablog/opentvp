// ============================================================
// FONCTIONS
// ============================================================

// 49 échantillons de tv_CameraInterpolation, écrits dans le projet
FUNCTION Sample(cname)
	LOCAL s u key px py pa pz
	FOR s = 0 TO 48
		u = s / 48.0
		tv_CameraInterpolation u
		PARSE result px py pa pz
		// une clé par composante, valeurs sans séparateur (les virgules
		// cassent les écritures)
		key = CONCAT(cname, "_x")
		key = CONCAT(key, s)
		tv_WriteProjectString "camtest" key px
		key = CONCAT(cname, "_a")
		key = CONCAT(key, s)
		tv_WriteProjectString "camtest" key pa
		key = CONCAT(cname, "_z")
		key = CONCAT(key, s)
		tv_WriteProjectString "camtest" key pz
	END
END

// Supprime les n points de caméra (toujours l'index 0)
FUNCTION ClearPoints(n)
	LOCAL k
	FOR k = 1 TO n
		tv_CameraRemovePoint 0
	END
END
